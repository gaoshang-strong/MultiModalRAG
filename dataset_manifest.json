    {
      "id": "FDU",
      "name": "FDU Gastric Cancer Cohort",
      "description": "Prospective Chinese gastric cancer cohort, Fudan University. Targeted panel DNA sequencing (503 cancer genes). Primary analysis cohort for all Phase 0–1 analyses.",
      "n_samples": 530,
      "n_somatic_samples": 472,
      "population": "Chinese",
      "cancer_type": "Stomach Adenocarcinoma",
      "sequencing_type": "targeted_panel",
      "sequencing_genes": 503,
      "source": "internal",
      "files": {
        "master_table": {
          "path": "analysis_results/Phase0/filtered_master_sample_table.tsv",
          "format": "TSV",
          "description": "Primary analysis table: one row per sample, clinical variables + binary somatic mutation columns (somatic_GENE = mutation count)",
          "n_rows": 530,
          "key_columns": {
            "sample_id": "unique sample identifier",
            "somatic_GENE": "mutation count per gene (column for each of 503 panel genes; prefix somatic_)",
            "TMB_report_numeric": "tumor mutation burden (mut/Mb, continuous)",
            "MSI": "microsatellite instability status: MSS | MSI-H",
            "MMR": "mismatch repair status",
            "HER2": "HER2 IHC/FISH status",
            "EBER": "EBV status (1=positive)",
            "histology": "Chinese-language histology label",
            "pT": "pathologic T stage",
            "pN": "pathologic N stage",
            "path_stage": "pathologic overall stage",
            "primary_site": "tumor anatomic location",
            "sex": "patient sex",
            "age": "patient age at surgery"
          }
        },
        "raw_maf_no_treatment": {
          "path": "Target_panel_DNA_seq_FDU/MAF_data/2025.12.29 patients without treatment before surgery.csv",
          "format": "CSV",
          "description": "Raw MAF-format somatic mutations, treatment-naive patients only (n=472)",
          "n_rows": 472,
          "key_columns": {
            "Tumor_Sample_Barcode": "sample ID",
            "Hugo_Symbol": "gene name",
            "Variant_Classification": "mutation type"
          }
        },
        "clinical": {
          "path": "Target_panel_DNA_seq_FDU/MAF_data/clinical_with_DNA_seq_with_full_TMB_filtered_samples.csv",
          "format": "CSV",
          "description": "Clinical data joined with sequencing QC and TMB",
          "n_rows": 480
        }
      },
      "key_variables": {
        "msi_column": "MSI",
        "msi_values": {"positive": ["MSI-H", "MSI"], "negative": ["MSS"]},
        "tmb_column": "TMB_report_numeric",
        "tmb_unit": "mut/Mb",
        "somatic_column_prefix": "somatic_",
        "somatic_value": "mutation count (>0 means mutated)"
      },
      "notes": "Master table is the primary entry point. Somatic columns already binarised. For gene-level analysis use master_table directly. For variant-level detail use raw_maf."
    },

